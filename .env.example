# Copy to .env (never commit it). Used by docker-compose; for a local run export the variables or pass them inline.
SECRET_KEY=                       # 32+ random characters. If empty, one is generated and kept in DATA_DIR/.secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=                   # optional; stays on the server. Users still have to consent in Settings
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=                     # comma-separated; empty = same-origin only
MAX_UPLOAD_MB=8
LOG_LEVEL=info
HOST=127.0.0.1                    # docker-compose sets 0.0.0.0 inside the container
PORT=8000
DATA_DIR=./backend/data           # SQLite file + uploads + reports live here
